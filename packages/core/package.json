{
  "name": "@sighash-dev/core",
  "version": "0.0.9",
  "description": "Framework-agnostic Bitcoin wallet connector core for Xverse, UniSat, and OKX.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "catalog:",
    "bitcoinjs-lib": "catalog:",
    "sats-connect": "catalog:"
  },
  "peerDependencies": {
    "nanostores": ">=0.11"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nanostores": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
